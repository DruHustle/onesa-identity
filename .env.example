# Set these independently for staging and production, in the host's secret store.
OIDC_ISSUER=https://auth.example.invalid/
# Production provider: https://auth.onesa.eu/ (Auth0 custom domain)
# Production Account: https://account.onesa.eu (independent Oracle ingress)
IDENTITY_ORIGIN=https://identity-admin.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ACTION_POLICY_KEY=
AUTH0_DATABASE_CONNECTION=
IDENTITY_DATABASE=/data/identity.sqlite
PORT=8080
RESOURCE_CLIENTS_JSON={}

# Optional JSON map of product/platform/tier to exact registration completion URLs.
REGISTRATION_RETURNS_JSON=
